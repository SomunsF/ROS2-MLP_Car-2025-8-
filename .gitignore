# ROS2 build artifacts (exclude these)
build/
install/
log/

# Python bytecode
__pycache__/
*.pyc

# IDE files to exclude (especially the large database file)
.vscode/browse.vc.db*
.vscode/browse.vc.db-shm
.vscode/browse.vc.db-wal
.idea/

# OS files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.log
*.bak

# Everything else is included by default
# The four folders we want to upload: end-end_train/, maps/, maps-1/, maps-2/, src/